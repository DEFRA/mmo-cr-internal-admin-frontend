{#
  Shared create / amend user fields.
  Expects: values, fieldErrors, administrations, askAssistedDigital
#}
{% set errors = fieldErrors or {} %}

{{ govukInput({
  id: "full-name",
  name: "full-name",
  autocomplete: "name",
  spellcheck: false,
  classes: "govuk-!-width-two-thirds",
  label: { text: "Full name or company name", classes: "govuk-label--s" },
  value: values["full-name"],
  errorMessage: { text: errors["full-name"] } if errors["full-name"]
}) }}

{{ govukInput({
  id: "email-address",
  name: "email-address",
  type: "email",
  autocomplete: "email",
  spellcheck: false,
  classes: "govuk-!-width-two-thirds",
  label: { text: "Email address", classes: "govuk-label--s" },
  hint: { text: "Leave this blank if the user needs assisted digital support." } if askAssistedDigital,
  value: values["email-address"],
  errorMessage: { text: errors["email-address"] } if errors["email-address"]
}) }}

{% if askAssistedDigital %}
  {{ govukRadios({
    idPrefix: "assisted-digital",
    name: "assisted-digital",
    classes: "govuk-radios--inline",
    fieldset: { legend: { text: "Does this user need assisted digital support?", classes: "govuk-fieldset__legend--s" } },
    items: [
      { value: "yes", text: "Yes", checked: values["assisted-digital"] == "yes" },
      { value: "no", text: "No", checked: values["assisted-digital"] == "no" }
    ],
    errorMessage: { text: errors["assisted-digital"] } if errors["assisted-digital"]
  }) }}
{% endif %}

{{ govukInput({
  id: "telephone-number",
  name: "telephone-number",
  type: "tel",
  autocomplete: "tel",
  classes: "govuk-!-width-one-half",
  label: { text: "Telephone number (optional)", classes: "govuk-label--s" },
  value: values["telephone-number"]
}) }}

{% call govukFieldset({ legend: { text: "Postal address", classes: "govuk-fieldset__legend--s" } }) %}
  {{ govukInput({
    id: "address-line-1",
    name: "address-line-1",
    autocomplete: "address-line1",
    classes: "govuk-!-width-one-half",
    label: { text: "Address line 1" },
    value: values["address-line-1"],
    errorMessage: { text: errors["address-line-1"] } if errors["address-line-1"]
  }) }}

  {{ govukInput({
    id: "address-line-2",
    name: "address-line-2",
    autocomplete: "address-line2",
    classes: "govuk-!-width-one-half",
    label: { text: "Address line 2 (optional)" },
    value: values["address-line-2"]
  }) }}

  {{ govukInput({
    id: "address-town-city",
    name: "address-town-city",
    autocomplete: "address-level2",
    classes: "govuk-!-width-one-half",
    label: { text: "Town or city" },
    value: values["address-town-city"],
    errorMessage: { text: errors["address-town-city"] } if errors["address-town-city"]
  }) }}

  {{ govukInput({
    id: "address-postcode",
    name: "address-postcode",
    autocomplete: "postal-code",
    classes: "govuk-!-width-one-half",
    label: { text: "Postcode" },
    value: values["address-postcode"],
    errorMessage: { text: errors["address-postcode"] } if errors["address-postcode"]
  }) }}
{% endcall %}

{{ govukSelect({
  id: "administration",
  name: "administration",
  classes: "govuk-!-width-one-half",
  label: { text: "Administration", classes: "govuk-label--s" },
  items: administrations | toSelectItems(values.administration, "Select an administration"),
  errorMessage: { text: errors.administration } if errors.administration
}) }}
