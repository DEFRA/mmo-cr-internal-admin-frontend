{% extends 'layouts/public.njk' %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if errorList %}
        {{ govukErrorSummary({ titleText: "There is a problem", errorList: errorList }) }}
      {% endif %}

      <h1 class="govuk-heading-xl">Sign in</h1>
      <p class="govuk-body">Use a test email address and password for this prototype. Do not use your real sign-in details.</p>

      <form method="post" action="/sign-in" novalidate>
        <input type="hidden" name="crumb" value="{{ crumb }}">

        {{ govukInput({
          id: "email",
          name: "email",
          type: "email",
          autocomplete: "email",
          spellcheck: false,
          classes: "govuk-!-width-two-thirds",
          label: { text: "Email address", classes: "govuk-label--s" },
          value: values.email,
          errorMessage: { text: fieldErrors.email } if fieldErrors.email
        }) }}

        {{ govukInput({
          id: "password",
          name: "password",
          type: "password",
          autocomplete: "current-password",
          classes: "govuk-!-width-two-thirds",
          label: { text: "Password", classes: "govuk-label--s" },
          errorMessage: { text: fieldErrors.password } if fieldErrors.password
        }) }}

        {{ govukButton({ text: "Sign in", preventDoubleClick: true }) }}
      </form>
    </div>
  </div>
{% endblock %}
