{% extends 'layouts/page.njk' %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if errorList %}
        {{ govukErrorSummary({ titleText: "There is a problem", errorList: errorList }) }}
      {% endif %}

      {{ appPageHeading({ caption: user.fullName, text: "Remove a vessel" }) }}

      {% if vesselOptions.length %}
        <form method="post" action="/users/{{ user.id }}/vessels/remove" novalidate>
          <input type="hidden" name="crumb" value="{{ crumb }}">

          {{ govukSelect({
            id: "vessel",
            name: "vessel",
            classes: "govuk-!-width-one-half",
            label: { text: "Vessel", classes: "govuk-label--s" },
            hint: { text: "Search by vessel name, PLN (vessel reference) or RSS number." },
            items: vesselOptions | toSelectItems(values.vessel, ""),
            formGroup: { classes: "app-autocomplete--one-half" },
          attributes: { "data-module": "app-autocomplete", "data-result-noun": "vessels" },
            errorMessage: { text: fieldErrors.vessel } if fieldErrors.vessel
          }) }}

          <div class="govuk-button-group">
            {{ govukButton({ text: "Remove a vessel", preventDoubleClick: true }) }}
            <a class="govuk-link" href="/users/{{ user.id }}">Cancel</a>
          </div>
        </form>
      {% else %}
        <p class="govuk-body" data-testid="no-vessels-to-remove">No eligible vessels are available to remove.</p>
      {% endif %}
    </div>
  </div>
{% endblock %}
