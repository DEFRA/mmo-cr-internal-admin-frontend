{% extends 'layouts/page.njk' %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if user.email %}
        {{ govukPanel({
          titleText: "User created",
          html: "Invitation email marked as sent to<br><strong>" + (user.email | escape) + "</strong>"
        }) }}
        {{ govukInsetText({ text: "Email delivery is simulated in this prototype. No real email has been sent." }) }}
      {% else %}
        {{ govukPanel({ titleText: "User created" }) }}
      {% endif %}

      <h2 class="govuk-heading-m">What happens next</h2>
      <p class="govuk-body">The user is listed as invited. You can link them to a vessel from that vessel’s profile.</p>

      {{ govukButton({ text: "View vessels", href: "/vessels" }) }}

      <p class="govuk-body"><a class="govuk-link" href="/users/{{ user.id }}">View user account</a></p>
      <p class="govuk-body"><a class="govuk-link" href="/users">Return to users</a></p>
    </div>
  </div>
{% endblock %}
