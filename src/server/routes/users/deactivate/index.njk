{% extends 'layouts/page.njk' %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {{ appPageHeading({ caption: "User account", text: "Deactivate " + user.fullName + "?" }) }}

      <p class="govuk-body">They will no longer be able to access the service. Their user record, vessel links and trip history will be kept.</p>

      {{ govukSummaryList({
        rows: [
          { key: { text: "Name" }, value: { text: user.fullName } },
          { key: { text: "User ID" }, value: { text: user.id } },
          { key: { text: "Current status" }, value: { text: statusText } }
        ]
      }) }}

      <form method="post" action="/users/{{ user.id }}/deactivate" novalidate>
        <input type="hidden" name="crumb" value="{{ crumb }}">
        <div class="govuk-button-group">
          {{ govukButton({ text: "Deactivate user", classes: "govuk-button--warning", preventDoubleClick: true }) }}
          {{ govukButton({ text: "Cancel", href: "/users/" + user.id, classes: "govuk-button--secondary" }) }}
        </div>
      </form>
    </div>
  </div>
{% endblock %}
