{% extends 'layouts/page.njk' %}

{% block content %}
  {% set amendButton %}
    {% if permissions.amendCatch %}
      {{ govukButton({ text: "Amend catch recording", href: "/fishing-trips/" + trip.tripId + "/amend", isStartButton: true }) }}
    {% endif %}
  {% endset %}

  {# Layout testing Option 2 (two-column information) has a hidden heading and the action first #}
  {% if twoColumnLayout %}
    <h1 class="govuk-visually-hidden">Trip details</h1>
  {% else %}
    {{ appPageHeading({ caption: caption, text: "Trip " + trip.tripId }) }}
  {% endif %}

  {% if notice %}
    <div class="govuk-inset-text app-inset-text--profile" data-testid="trip-version-notice">
      {% if notice.dateTime %}
        {{ notice.text }} {{ notice.dateTime | formatDate("d MMMM yyyy, HH:mm") }}.
      {% else %}
        {{ notice.text }} <a class="govuk-link" href="{{ notice.href }}">{{ notice.linkText }}</a>
      {% endif %}
    </div>
  {% endif %}

  {% if twoColumnLayout %}{{ amendButton | safe }}{% endif %}

  <h2 class="govuk-heading-m">Trip information</h2>

  {% set vesselHtml %}
    {% if trip.vesselId %}<a class="govuk-link" href="/vessels/{{ trip.vesselId }}">{{ trip.vesselName }}</a>{% else %}{{ trip.vesselName }}{% endif %}
  {% endset %}
  {% set creatorHtml %}
    {% if creatorHref %}<a class="govuk-link" href="{{ creatorHref }}">{{ trip.createdBy }}</a>{% else %}{{ trip.createdBy }}{% endif %}
  {% endset %}

  {% set mainRows = [
      { key: { text: "Status" }, value: { html: govukTag(view.status | tripStatusTag) } },
      { key: { text: "Vessel name" }, value: { html: vesselHtml } },
      { key: { text: "PLN" }, value: { text: trip.pln } },
      { key: { text: "Trip start date" }, value: { text: trip.tripStartDate | formatDate("d MMMM yyyy") } },
      { key: { text: "Trip end date" }, value: { text: trip.tripEndDate | formatDate("d MMMM yyyy") } },
      { key: { text: "Departure port" }, value: { text: trip.departurePort } },
      { key: { text: "Return port" }, value: { text: trip.returnPort } },
      { key: { text: "Created by" }, value: { html: creatorHtml } },
      { key: { text: "User role" }, value: { text: trip.userRole } }
  ] %}

  {% set otherRows = [
    { key: { text: "Retained catch" }, value: { text: view.retainedCatch } },
    { key: { text: "Admin port" }, value: { text: trip.adminPort } },
    { key: { text: "Port code" }, value: { text: trip.portCode } },
    { key: { text: "Created on" }, value: { text: trip.createdOn | formatDate("d MMMM yyyy, HH:mm") } },
    { key: { text: "Received on" }, value: { text: trip.receivedOn | formatDate("d MMMM yyyy, HH:mm") } },
    { key: { text: "Late submission" }, value: { text: trip.lateSubmission } },
    { key: { text: "Submission method" }, value: { text: methodLabel } },
    { key: { text: "Amended" }, value: { text: "Yes" if hasAmendments else "No" } },
    { key: { text: "Amendment reason" }, value: { text: view.amendment.reason if view.amendment else "N/A" } }
  ] %}

  {# Layout testing Option 2 shows trip details and record status in two columns #}
  {% if twoColumnLayout %}
    {% set tripColumn = [
      { key: { text: "Trip ID" }, value: { text: trip.tripId } },
      { key: { text: "Vessel name" }, value: { html: vesselHtml } },
      { key: { text: "PLN" }, value: { text: trip.pln } },
      { key: { text: "Created by" }, value: { html: creatorHtml } },
      { key: { text: "User role" }, value: { text: trip.userRole } },
      { key: { text: "Departure date" }, value: { text: trip.tripStartDate | formatDate("d MMMM yyyy") } },
      { key: { text: "Departure port" }, value: { text: trip.departurePort } },
      { key: { text: "Return date" }, value: { text: trip.tripEndDate | formatDate("d MMMM yyyy") } },
      { key: { text: "Return port" }, value: { text: trip.returnPort } }
    ] %}
    {% set statusColumn = [
      { key: { text: "Status" }, value: { html: govukTag(view.status | tripStatusTag) } },
      { key: { text: "Created on" }, value: { text: trip.createdOn | formatDate("d MMMM yyyy, HH:mm") } },
      { key: { text: "Received on" }, value: { text: trip.receivedOn | formatDate("d MMMM yyyy, HH:mm") } },
      { key: { text: "Submission method" }, value: { text: methodLabel } },
      { key: { text: "Amended" }, value: { text: "Yes" if hasAmendments else "No" } },
      { key: { text: "Retained catch" }, value: { text: view.retainedCatch } },
      { key: { text: "Admin port" }, value: { text: trip.adminPort } },
      { key: { text: "Admin port code" }, value: { text: trip.portCode } }
    ] %}
    {% if view.amendment %}
      {% set statusColumn = statusColumn.concat([{ key: { text: "Amendment reason" }, value: { text: view.amendment.reason } }]) %}
    {% endif %}
    <div class="govuk-grid-row" data-testid="trip-information">
      <div class="govuk-grid-column-one-half">
        {{ govukSummaryList({ classes: "govuk-!-margin-bottom-9 app-summary-list--profile", rows: tripColumn }) }}
      </div>
      <div class="govuk-grid-column-one-half">
        {{ govukSummaryList({ classes: "govuk-!-margin-bottom-9 app-summary-list--profile", rows: statusColumn }) }}
      </div>
    </div>
  {% elif tabbedLayout %}
    {# Current layout: vessel and user details are in their own tabs #}
    {% set tripRows = [
      mainRows[0],
      { key: { text: "PLN" }, value: { text: trip.pln } },
      { key: { text: "Trip start date" }, value: { text: trip.tripStartDate | formatDate("d MMMM yyyy") } },
      { key: { text: "Trip end date" }, value: { text: trip.tripEndDate | formatDate("d MMMM yyyy") } }
    ] %}
    {{ govukSummaryList({
      classes: "govuk-!-margin-bottom-9 app-summary-list--profile",
      attributes: { "data-testid": "trip-information" },
      rows: tripRows.concat(otherRows)
    }) }}
  {% else %}
    {{ govukSummaryList({
      classes: "govuk-!-margin-bottom-9 app-summary-list--profile",
      attributes: { "data-testid": "trip-information" },
      rows: mainRows
    }) }}

    {% set otherHtml %}
      {{ govukSummaryList({ classes: "app-summary-list--profile", rows: otherRows }) }}
    {% endset %}
    {{ govukDetails({ summaryText: "Other trip information", html: otherHtml }) }}
  {% endif %}

  {% if not twoColumnLayout %}{{ amendButton | safe }}{% endif %}

  {% set catchHtml %}
    <h2 class="govuk-heading-l">Catch breakdown</h2>
    {% for gear in view.gears %}
      <h3 class="govuk-heading-s">Gear {{ loop.index }}: {{ gear.name }}</h3>
      <p class="govuk-body"><strong>Measurements:</strong> {{ gear.measurements }}</p>
      <p class="govuk-body"><strong>Subrectangle:</strong> {{ gear.subrectangle }}</p>
      <div class="app-table-scroll app-table-scroll--wrap" role="region" aria-label="Catches using gear {{ loop.index }}: {{ gear.name }}" tabindex="0">
        <table class="govuk-table" data-testid="catch-table">
          <caption class="govuk-visually-hidden">Catches using gear {{ loop.index }}: {{ gear.name }}</caption>
          <thead class="govuk-table__head">
            <tr class="govuk-table__row">
              {% for column in gear.columns %}<th scope="col" class="govuk-table__header">{{ column }}</th>{% endfor %}
            </tr>
          </thead>
          <tbody class="govuk-table__body">
            {% for row in gear.rows %}
              <tr class="govuk-table__row">
                {% for cell in row %}<td class="govuk-table__cell">{{ cell }}</td>{% endfor %}
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% else %}
      <p class="govuk-body">No catch recorded for this trip.</p>
    {% endfor %}
  {% endset %}

  {% set historyHtml %}
    <h2 class="govuk-heading-l">History</h2>
    <table class="govuk-table" data-testid="trip-history">
      <thead class="govuk-table__head">
        <tr class="govuk-table__row">
          <th scope="col" class="govuk-table__header">Date and time</th>
          <th scope="col" class="govuk-table__header">Action</th>
          <th scope="col" class="govuk-table__header">Performed by</th>
        </tr>
      </thead>
      <tbody class="govuk-table__body">
        {% for event in history %}
          <tr class="govuk-table__row">
            <td class="govuk-table__cell">{{ event.dateTime | formatDate("d MMMM yyyy, HH:mm") }}</td>
            <td class="govuk-table__cell">{{ event.action }}</td>
            <td class="govuk-table__cell">{{ event.performedBy }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
    {% if historyPagination %}
      {{ govukPagination(historyPagination | assign({ landmarkLabel: "History pagination" })) }}
    {% endif %}
    {% if permissions.auditLog %}
    <p class="govuk-body">
      <a class="govuk-link" href="/audit-log?s={{ trip.tripId }}">View all history for this trip</a>
    </p>
    {% endif %}
  {% endset %}

  {% set vesselTabHtml %}
    <h2 class="govuk-heading-l">Vessel</h2>
    <table class="govuk-table" data-testid="trip-vessel">
      <thead class="govuk-table__head">
        <tr class="govuk-table__row">
          <th scope="col" class="govuk-table__header">Vessel</th>
          <th scope="col" class="govuk-table__header">PLN</th>
          <th scope="col" class="govuk-table__header">Departure port</th>
          <th scope="col" class="govuk-table__header">Return port</th>
        </tr>
      </thead>
      <tbody class="govuk-table__body">
        <tr class="govuk-table__row">
          <td class="govuk-table__cell">{{ vesselHtml | safe }}</td>
          <td class="govuk-table__cell">{{ trip.pln }}</td>
          <td class="govuk-table__cell">{{ trip.departurePort }}</td>
          <td class="govuk-table__cell">{{ trip.returnPort }}</td>
        </tr>
      </tbody>
    </table>
  {% endset %}

  {% set userTabHtml %}
    <h2 class="govuk-heading-l">User</h2>
    <table class="govuk-table" data-testid="trip-user">
      <thead class="govuk-table__head">
        <tr class="govuk-table__row">
          <th scope="col" class="govuk-table__header">Name</th>
          <th scope="col" class="govuk-table__header">Role</th>
        </tr>
      </thead>
      <tbody class="govuk-table__body">
        <tr class="govuk-table__row">
          <td class="govuk-table__cell">{{ creatorHtml | safe }}</td>
          <td class="govuk-table__cell">{{ trip.userRole }}</td>
        </tr>
      </tbody>
    </table>
  {% endset %}

  {% set notesHtml %}
    <h2 class="govuk-heading-l">Notes</h2>
    {{ appNotes({
      action: "/fishing-trips/" + trip.tripId + "/notes",
      crumb: crumb,
      notes: trip.notes,
      numbered: true,
      listFirst: true,
      bordered: true,
      emptyText: "No notes recorded for this trip."
    }) }}
  {% endset %}

  {% if tabbedLayout %}
    {{ govukTabs({
      classes: "app-profile-tabs app-profile-tabs--tight",
      items: [
        { label: "Catch breakdown", id: "catch-breakdown", panel: { html: catchHtml } },
        { label: "Vessel", id: "vessel", panel: { html: vesselTabHtml } },
        { label: "User", id: "user", panel: { html: userTabHtml } },
        { label: "History", id: "history", panel: { html: historyHtml } },
        { label: "Notes", id: "notes", panel: { html: notesHtml } }
      ]
    }) }}
  {% else %}
    {{ govukTabs({
      classes: "app-profile-tabs app-profile-tabs--tight",
      items: [
        { label: "Catch breakdown", id: "catch-breakdown", panel: { html: catchHtml } },
        { label: "History", id: "history", panel: { html: historyHtml } },
        { label: "Notes", id: "notes", panel: { html: notesHtml } }
      ]
    }) }}
  {% endif %}

  <div class="app-tab-actions" data-testid="trip-actions">
    {% if view.kind != "original" %}
      {{ govukButton({ text: "View original record", href: "/fishing-trips/" + trip.tripId + "?version=original", classes: "govuk-button--secondary" }) }}
    {% endif %}
    {% if hasAmendments %}
      {{ govukButton({ text: "View amended records", href: "/fishing-trips/" + trip.tripId + "/versions", classes: "govuk-button--secondary" }) }}
    {% endif %}
    {% if permissions.exportData %}
    {{ govukButton({ text: "Download PDF", href: "/fishing-trips/" + trip.tripId + "/pdf", classes: "govuk-button--secondary" }) }}
    {% endif %}
  </div>
{% endblock %}
